# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# TLS is enabled by default. Set false only for an isolated local development database.
MONGODB_TLS=true
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
SESSION_SECRET=replace-with-at-least-32-random-bytes
GEMINI_API_KEY=replace-with-your-api-key
# Set to 1 only behind a single trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=0
